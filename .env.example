# ─── Obligatorias ────────────────────────────────────────────────────────────
# Sin estas dos la aplicación no arranca (a propósito: es preferible fallar a
# arrancar con una configuración insegura).

# En Railway usar la referencia al servicio: ${{MongoDB.MONGO_URL}}/shellbox?authSource=admin
MONGODB_URI=mongodb://usuario:contraseña@host:puerto/shellbox?authSource=admin

# Generar uno propio, p. ej. con: openssl rand -base64 32
JWT_SECRET=

# ─── Imágenes de producto (bucket compatible con S3) ─────────────────────────
# Sin estas, el panel funciona pero no puede subir fotos.
AWS_S3_BUCKET_NAME=
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# ─── Solo para `npm run init:admin` ──────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
