# MongoDB Connection
# En Railway usar la referencia al servicio: ${{MongoDB.MONGO_URL}}/shellbox?authSource=admin
MONGODB_URI=mongodb://usuario:contraseña@host:puerto/shellbox?authSource=admin

# JWT Secret — generar uno propio, p.ej. con: openssl rand -base64 32
JWT_SECRET=

# Credenciales del primer admin (solo para `npm run init:admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
