---
import fs from 'node:fs';
import path from 'node:path';
import { TIENDAS } from '../../lib/config';

/**
 * Muro de tiendas.
 *
 * Si existe `public/tiendas/<slug>.svg` se pinta el logotipo real; si no, el
 * nombre con el color corporativo de la marca. La comprobación se hace al
 * construir, así que no cuesta nada en tiempo de ejecución.
 */
const carpetaLogos = path.join(process.cwd(), 'public', 'tiendas');

const tiendas = TIENDAS.map((tienda) => ({
  ...tienda,
  colorOscuro: 'colorOscuro' in tienda ? tienda.colorOscuro : tienda.color,
  logo: fs.existsSync(path.join(carpetaLogos, `${tienda.slug}.svg`))
    ? `/tiendas/${tienda.slug}.svg`
    : null,
}));

// La pista se duplica para que el desplazamiento sea continuo: la animación
// mueve -50%, que es exactamente el ancho de una copia.
const pista = [...tiendas, ...tiendas];
---

<section
  class="border-y py-14"
  style="border-color: var(--border); background-color: var(--bg-subtle)"
  aria-labelledby="titulo-tiendas"
>
  <p
    id="titulo-tiendas"
    class="mb-9 text-center text-xs font-semibold tracking-[0.2em] uppercase"
    style="color: var(--text-faint)"
  >
    Compramos en cualquier tienda con envío a Estados Unidos
  </p>

  <div class="marquee relative overflow-hidden">
    <!-- Difuminado en los bordes para que la pista no se corte en seco. -->
    <div
      class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 sm:w-32"
      style="background: linear-gradient(to right, var(--bg-subtle), transparent)"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 sm:w-32"
      style="background: linear-gradient(to left, var(--bg-subtle), transparent)"
      aria-hidden="true"
    >
    </div>

    <ul class="marquee-track flex w-max items-center gap-3">
      {
        pista.map((tienda, i) => (
          <li
            class="tienda-chip group flex shrink-0 items-center gap-2.5 rounded-2xl px-5 py-3.5 whitespace-nowrap"
            style={`--marca: ${tienda.color}; --marca-oscuro: ${tienda.colorOscuro}; background-color: var(--surface); border: 1px solid var(--border);`}
            aria-hidden={i >= tiendas.length ? 'true' : undefined}
          >
            {
              tienda.logo ? (
                <img
                  src={tienda.logo}
                  alt={tienda.nombre}
                  class="h-6 w-auto max-w-[7rem] object-contain"
                  loading="lazy"
                />
              ) : (
                <>
                  {/* Punto del color de la marca, como ancla visual del nombre. */}
                  <span class="punto-marca h-2.5 w-2.5 shrink-0 rounded-full" aria-hidden="true" />
                  <span class="nombre-marca text-base font-bold tracking-tight">
                    {tienda.nombre}
                  </span>
                </>
              )
            }
          </li>
        ))
      }
    </ul>
  </div>

  <p class="mt-9 text-center text-sm" style="color: var(--text-faint)">
    ¿No ves tu tienda? Escríbenos, casi seguro que también la traemos.
  </p>
</section>

<style>
  .punto-marca {
    background-color: var(--marca);
  }

  .nombre-marca {
    color: var(--marca);
  }

  /* Las marcas de color negro serían invisibles sobre el fondo oscuro. */
  :global(.dark) .punto-marca {
    background-color: var(--marca-oscuro);
  }

  :global(.dark) .nombre-marca {
    color: var(--marca-oscuro);
  }

  /* Al pasar por encima, el borde toma el color de la marca. */
  .tienda-chip {
    transition:
      border-color 0.3s,
      transform 0.3s;
  }

  .tienda-chip:hover {
    border-color: color-mix(in srgb, var(--marca) 55%, transparent);
    transform: translateY(-2px);
  }

  :global(.dark) .tienda-chip:hover {
    border-color: color-mix(in srgb, var(--marca-oscuro) 45%, transparent);
  }
</style>
