---
import { TARIFAS, PAGO, whatsappLink } from '../../lib/config';

const cta = whatsappLink('¡Hola ShellBox! Quiero saber cuánto me costaría traer mi encargo.');
---

<section class="py-28 sm:py-32" id="tarifas">
  <div class="mx-auto max-w-6xl px-6 sm:px-8 lg:px-12">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-semibold tracking-[0.2em] uppercase"
        style="color: var(--color-brand-coral)"
      >
        Tarifas
      </p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
        Precio por libra, sin letra pequeña
      </h2>
      <p class="mt-5 text-lg" style="color: var(--text-muted)">
        Clasificamos tu mercancía según sus características físicas y su volumen. Te decimos
        el costo exacto antes de comprar nada.
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {
        TARIFAS.map((tarifa, i) => (
          <div
            class:list={[
              'reveal card card-hover relative overflow-hidden p-8 sm:p-10',
              tarifa.destacada && 'ring-gradient',
            ]}
            style={`--reveal-delay: ${i * 100}ms`}
          >
            {tarifa.destacada && (
              <span
                class="bg-gradient-brand absolute top-0 right-0 rounded-bl-xl px-4 py-1.5 text-xs font-bold tracking-wide text-white uppercase"
                aria-label="La opción más frecuente"
              >
                Más común
              </span>
            )}

            <h3 class="text-2xl font-bold">{tarifa.nombre}</h3>

            <div class="mt-6 flex items-baseline gap-2">
              <span
                class:list={[
                  'text-6xl font-extrabold tracking-tight',
                  tarifa.destacada && 'text-gradient',
                ]}
              >
                ${tarifa.precio}
              </span>
              <span class="text-lg font-medium" style="color: var(--text-muted)">
                USD / libra
              </span>
            </div>

            <p class="mt-6 leading-relaxed" style="color: var(--text-muted)">
              {tarifa.descripcion}
            </p>

            <div class="mt-8 h-px" style="background-color: var(--border)" />

            <div class="mt-6 flex items-center gap-3">
              <svg
                class="h-5 w-5 shrink-0"
                style="color: var(--color-brand-teal)"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <p class="text-sm" style="color: var(--text-muted)">
                Entrega estimada:{' '}
                <strong class="font-semibold" style="color: var(--text)">
                  {tarifa.entrega}
                </strong>
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Condiciones de pago -->
    <div class="reveal card mt-6 p-8 sm:p-10">
      <div class="grid gap-8 sm:grid-cols-3">
        <div>
          <h3 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-faint)">
            Cuándo se paga
          </h3>
          <p class="mt-3 text-lg font-semibold">{PAGO.momento}</p>
          <p class="mt-1 text-sm" style="color: var(--text-muted)">
            No adelantas dinero en ningún momento.
          </p>
        </div>

        <div>
          <h3 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-faint)">
            Cómo se paga
          </h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              PAGO.metodos.map((metodo) => (
                <span
                  class="rounded-lg px-3 py-1.5 text-sm font-semibold"
                  style="background-color: var(--bg-subtle); border: 1px solid var(--border)"
                >
                  {metodo}
                </span>
              ))
            }
          </div>
          <p class="mt-3 text-sm" style="color: var(--text-muted)">{PAGO.nota}</p>
        </div>

        <div>
          <h3 class="text-sm font-semibold tracking-wide uppercase" style="color: var(--text-faint)">
            En qué moneda
          </h3>
          <p class="mt-3 text-lg font-semibold">Únicamente {PAGO.moneda}</p>
          <a
            href={cta}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold transition-colors"
            style="color: var(--color-brand-coral)"
          >
            Pedir mi cotización
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
