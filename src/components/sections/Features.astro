---
import { VENTAJAS, ENTREGA } from '../../lib/config';
---

<section class="py-28 sm:py-32" id="ventajas">
  <div class="mx-auto max-w-6xl px-6 sm:px-8 lg:px-12">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-semibold tracking-[0.2em] uppercase"
        style="color: var(--color-brand-pink)"
      >
        Por qué ShellBox
      </p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
        Lo que nos hace distintos
      </h2>
      <p class="mt-5 text-lg" style="color: var(--text-muted)">
        Cuatro compromisos que sostenemos en cada encargo.
      </p>
    </div>

    <div class="mt-16 grid gap-6 sm:grid-cols-2">
      {
        VENTAJAS.map((ventaja, i) => (
          <article class="reveal card card-hover p-8" style={`--reveal-delay: ${i * 90}ms`}>
            <div
              class="flex h-12 w-12 items-center justify-center rounded-xl"
              style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-brand-amber) 16%, transparent), color-mix(in srgb, var(--color-brand-pink) 16%, transparent))"
            >
              <svg
                class="h-6 w-6"
                style="color: var(--color-brand-coral)"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.7"
                aria-hidden="true"
              >
                {ventaja.icono === 'transparencia' && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                )}
                {ventaja.icono === 'seguridad' && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
                  />
                )}
                {ventaja.icono === 'asesoramiento' && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 18.75a6 6 0 006-6v-1.5m-12 1.5v1.5a6 6 0 006 6zm0 0v2.25M3.75 12v-1.5a8.25 8.25 0 1116.5 0V12m-16.5 0h2.25a.75.75 0 01.75.75v3a.75.75 0 01-.75.75H3.75a.75.75 0 01-.75-.75v-3a.75.75 0 01.75-.75zm15 0h2.25a.75.75 0 01.75.75v3a.75.75 0 01-.75.75H18.75a.75.75 0 01-.75-.75v-3a.75.75 0 01.75-.75z"
                  />
                )}
                {ventaja.icono === 'diversidad' && (
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"
                  />
                )}
              </svg>
            </div>

            <h3 class="mt-6 text-xl font-bold">{ventaja.titulo}</h3>
            <p class="mt-3 leading-relaxed" style="color: var(--text-muted)">
              {ventaja.descripcion}
            </p>
          </article>
        ))
      }
    </div>

    <!-- Datos de la entrega en Cuba -->
    <div class="reveal card mt-6 overflow-hidden">
      <!-- Separadores: horizontales apilado, verticales en fila. -->
      <div class="grid sm:grid-cols-3">
        {
          [
            { etiqueta: 'Punto de recogida', valor: ENTREGA.lugar },
            { etiqueta: 'Plazo para recoger', valor: ENTREGA.plazoRecogida },
            { etiqueta: 'Aviso de llegada', valor: ENTREGA.aviso },
          ].map((dato, i) => (
            <div
              class:list={['p-8', i > 0 && 'border-t sm:border-t-0 sm:border-l']}
              style="border-color: var(--border)"
            >
              <p
                class="text-xs font-semibold tracking-[0.18em] uppercase"
                style="color: var(--text-faint)"
              >
                {dato.etiqueta}
              </p>
              <p class="mt-3 text-xl font-bold">{dato.valor}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
