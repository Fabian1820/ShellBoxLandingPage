---
import { PASOS, whatsappLink } from '../../lib/config';
import IconoPaso from '../ui/IconoPaso.astro';

const cta = whatsappLink('¡Hola ShellBox! Les paso el enlace de mi carrito para empezar.');
---

<section class="py-28 sm:py-32" id="como-funciona" style="background-color: var(--bg-subtle)">
  <div class="mx-auto max-w-6xl px-6 sm:px-8 lg:px-12">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-semibold tracking-[0.2em] uppercase"
        style="color: var(--color-brand-teal)"
      >
        Cómo funciona
      </p>
      <h2 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
        Cuatro pasos y ya está en camino
      </h2>
      <p class="mt-5 text-lg" style="color: var(--text-muted)">
        Tú solo tienes que preparar el carrito. Del resto nos encargamos nosotros.
      </p>
    </div>

    <div class="relative mt-20">
      <!-- Línea que une los pasos en escritorio. -->
      <div
        class="pointer-events-none absolute top-[3.25rem] right-0 left-0 hidden h-px lg:block"
        style="background: linear-gradient(to right, transparent, var(--border) 12%, var(--border) 88%, transparent)"
        aria-hidden="true"
      >
      </div>

      <ol class="relative grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {
          PASOS.map((paso, i) => (
            <li class="reveal group" style={`--reveal-delay: ${i * 110}ms`}>
              <div class="relative mx-auto w-[6.5rem] lg:mx-0">
                <div
                  class="ring-gradient relative z-10 flex h-[6.5rem] w-[6.5rem] items-center justify-center rounded-full transition-transform duration-300 group-hover:scale-105"
                  style="background-color: var(--bg-subtle)"
                >
                  <IconoPaso paso={(i + 1) as 1 | 2 | 3 | 4} class="h-14 w-14" />
                </div>

                {/* El número queda como distintivo pequeño, sin robarle
                    protagonismo a la ilustración. */}
                <span
                  class="bg-gradient-brand absolute -top-1 -right-1 z-20 flex h-8 w-8 items-center justify-center rounded-full text-xs font-extrabold text-white"
                >
                  {paso.numero}
                </span>
              </div>

              <div class="mt-6 text-center lg:text-left">
                <h3 class="text-xl font-bold">{paso.titulo}</h3>
                <p class="mt-3 leading-relaxed" style="color: var(--text-muted)">
                  {paso.descripcion}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Aviso sobre las tiendas que exigen acceso a la cuenta. -->
    <div class="reveal card mt-16 p-7 sm:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <div
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl"
          style="background-color: color-mix(in srgb, var(--color-brand-teal) 14%, transparent)"
        >
          <svg
            class="h-6 w-6"
            style="color: var(--color-brand-teal)"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"
            ></path>
          </svg>
        </div>

        <div>
          <h3 class="text-lg font-bold">Dos formas de hacer el pedido</h3>
          <div class="mt-3 grid gap-4 sm:grid-cols-2">
            <p class="text-sm leading-relaxed" style="color: var(--text-muted)">
              <strong style="color: var(--text)">Amazon, Walmart y similares:</strong> nos envías
              el enlace del producto y nosotros hacemos la compra.
            </p>
            <p class="text-sm leading-relaxed" style="color: var(--text-muted)">
              <strong style="color: var(--text)">Shein, Temu, Fashion Nova y similares:</strong>
              dejas el carrito preparado en tu cuenta y accedemos únicamente para efectuar el
              pago.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="reveal mt-14 text-center">
      <a href={cta} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Empezar mi encargo
      </a>
    </div>
  </div>
</section>
