---
const steps = [
  {
    number: '01',
    title: 'Periodo de pedidos',
    description: 'Durante 5 días recogemos todos los pedidos. Envíanos los enlaces de Shein que deseas.',
  },
  {
    number: '02',
    title: 'Precio inmediato',
    description: 'Te damos el precio final al momento, con todos los costos incluidos. Sin sorpresas.',
  },
  {
    number: '03',
    title: 'Compra y envío',
    description: 'Compramos tus productos en España y los preparamos para el envío a Cuba.',
  },
  {
    number: '04',
    title: 'Entrega en Cuba',
    description: 'En 20-25 días recibes tu pedido en Cuba. Te mantenemos informado todo el tiempo.',
  },
];
---

<section class="py-32 bg-white" id="como-funciona">
  <div class="max-w-6xl mx-auto px-6 sm:px-8 lg:px-12">
    <!-- Section Header -->
    <div class="text-center mb-24">
      <h2 class="text-5xl md:text-6xl font-semibold text-gray-900 mb-6 tracking-tight">
        ¿Cómo funciona?
      </h2>
      <p class="text-xl text-gray-500 font-light max-w-2xl mx-auto leading-relaxed">
        Un proceso simple y transparente en 4 pasos
      </p>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step, index) => (
        <div
          class="relative"
          style={`animation: fadeInUp 0.6s ease-out forwards; animation-delay: ${index * 0.12}s; opacity: 0;`}
        >
          <!-- Step Card -->
          <div class="bg-gray-50 rounded-2xl p-8 hover:bg-gray-100 transition-colors duration-300">
            <!-- Number Badge - Más discreto -->
            <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-orange-100 mb-6">
              <span class="text-orange-500 font-semibold text-sm">{step.number}</span>
            </div>

            <!-- Content -->
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              {step.title}
            </h3>
            <p class="text-sm text-gray-600 font-light leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-16">
      <a
        href="https://www.instagram.com/shellboxencargos/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-8 py-3.5 bg-orange-500 text-white rounded-xl font-medium text-base hover:bg-orange-600 active:scale-[0.98] transition-all"
      >
        Comenzar mi encargo
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
