---
import fs from 'node:fs';
import path from 'node:path';

/**
 * Banda ancha con una fotografía de fondo.
 *
 * Si el archivo todavía no existe en `public/`, la sección se pinta con el
 * degradado de marca en su lugar: así se puede desplegar antes de tener las
 * fotos sin que quede un hueco roto.
 */
interface Props {
  /** Ruta pública de la imagen, p. ej. `/fotos/entrega.jpg`. */
  src: string;
  /** Texto alternativo. Cadena vacía si la foto es puramente decorativa. */
  alt?: string;
  titulo: string;
  texto: string;
  /** Oscurecimiento sobre la foto, para que el texto se lea. 0 a 1. */
  velo?: number;
}

const { src, alt = '', titulo, texto, velo = 0.55 } = Astro.props;

const existe = fs.existsSync(path.join(process.cwd(), 'public', src.replace(/^\//, '')));
---

<section class="relative overflow-hidden">
  {
    existe ? (
      <img
        src={src}
        alt={alt}
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        decoding="async"
      />
    ) : (
      /* Sin foto todavía: degradado de marca como sustituto digno. */
      <div class="bg-gradient-brand absolute inset-0" aria-hidden="true" />
    )
  }

  {/* Velo para asegurar el contraste del texto. Con foto hace falta bastante;
      sobre el degradado de marca basta con un toque, o se ensucia el color. */}
  <div
    class="absolute inset-0"
    style={existe
      ? `background: linear-gradient(to right, rgba(12,8,9,${velo + 0.2}), rgba(12,8,9,${velo}) 55%, rgba(12,8,9,${Math.max(velo - 0.25, 0.15)}))`
      : 'background: linear-gradient(to right, rgba(12,8,9,0.28), rgba(12,8,9,0.10) 60%, transparent)'}
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-6 py-28 sm:px-8 sm:py-36 lg:px-12">
    <div class="reveal max-w-xl">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{titulo}</h2>
      <p class="mt-5 text-lg leading-relaxed text-white/85">{texto}</p>
      <slot />
    </div>
  </div>
</section>
