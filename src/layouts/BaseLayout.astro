---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Páginas privadas como el panel no deben indexarse. */
  noindex?: boolean;
}

const {
  title = 'ShellBox Encargos — Tus compras de Estados Unidos, hasta tus manos',
  description = 'Recogemos encargos de todas las tiendas con envío a Estados Unidos y los llevamos a Cuba. Miscelánea a 6 USD la libra, precio exacto antes de comprar y pago al recibir.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://shellbox.up.railway.app');
const ogImage = new URL('/shellboxlogo.jpg', canonical);
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/shellboxlogo.jpg" />
    <link rel="apple-touch-icon" href="/shellboxlogo.jpg" />
    <link rel="canonical" href={canonical.href} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ee4e34" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0a0b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ShellBox Encargos" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    {/* Tema antes del primer pintado: sin esto el modo oscuro parpadea en blanco. */}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.remove('no-js');
        try {
          const guardado = localStorage.getItem('theme');
          const oscuro =
            guardado === 'dark' ||
            (!guardado && window.matchMedia('(prefers-color-scheme: dark)').matches);
          root.classList.toggle('dark', oscuro);
        } catch {
          /* Modo privado o cookies bloqueadas: se queda en claro. */
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-xl focus:bg-[var(--surface)] focus:px-4 focus:py-2 focus:font-medium focus:shadow-lg"
    >
      Saltar al contenido
    </a>
    <slot />

    <script is:inline>
      // Aparición progresiva al hacer scroll.
      //
      // El contenido queda oculto hasta que se marca como visible, así que un
      // fallo aquí dejaría la página en blanco. Por eso hay tres caminos:
      // el observador, una comprobación directa por posición, y una red de
      // seguridad final. Cualquiera de ellos basta para mostrar la página.
      (function () {
        var pendientes = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
        if (!pendientes.length) return;

        function mostrar(el) {
          el.classList.add('is-visible');
          var i = pendientes.indexOf(el);
          if (i > -1) pendientes.splice(i, 1);
        }

        function mostrarTodo() {
          while (pendientes.length) mostrar(pendientes[0]);
        }

        var sinMovimiento =
          !window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (sinMovimiento || !('IntersectionObserver' in window)) {
          mostrarTodo();
          return;
        }

        var observador = new IntersectionObserver(
          function (entradas) {
            entradas.forEach(function (entrada) {
              if (!entrada.isIntersecting) return;
              observador.unobserve(entrada.target);
              mostrar(entrada.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
        );

        pendientes.forEach(function (el) {
          observador.observe(el);
        });

        // Camino alternativo: comprueba la posición directamente. Cubre los
        // casos en que el observador no se dispara (pestaña en segundo plano,
        // renderizado suspendido, restauración desde caché).
        var programado = false;

        function revisarPorPosicion() {
          programado = false;
          var alto = window.innerHeight || document.documentElement.clientHeight;

          // Algunos contenedores embebidos informan una altura de cero. Ahí
          // nada llegaría a "estar en pantalla" nunca y la página se quedaría
          // vacía, así que se muestra todo.
          if (!alto) {
            mostrarTodo();
            desconectar();
            return;
          }

          pendientes.slice().forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.top < alto - 40 && r.bottom > 0) {
              observador.unobserve(el);
              mostrar(el);
            }
          });

          if (!pendientes.length) desconectar();
        }

        function alDesplazar() {
          if (programado) return;
          programado = true;
          // setTimeout y no requestAnimationFrame: rAF se suspende cuando la
          // pestaña no se está pintando, que es justo cuando este respaldo
          // tiene que funcionar.
          setTimeout(revisarPorPosicion, 60);
        }

        function desconectar() {
          window.removeEventListener('scroll', alDesplazar);
          window.removeEventListener('resize', alDesplazar);
          window.removeEventListener('pageshow', alDesplazar);
        }

        window.addEventListener('scroll', alDesplazar, { passive: true });
        window.addEventListener('resize', alDesplazar, { passive: true });
        window.addEventListener('pageshow', alDesplazar);

        revisarPorPosicion();

        // Red de seguridad: si a los 4 segundos sigue habiendo algo oculto
        // dentro de la pantalla, se muestra igualmente. Nunca una página en
        // blanco por un fallo de animación.
        setTimeout(function () {
          revisarPorPosicion();
          var alto = window.innerHeight || document.documentElement.clientHeight;
          pendientes.slice().forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.top < alto * 1.5) mostrar(el);
          });
        }, 4000);
      })();
    </script>
  </body>
</html>
