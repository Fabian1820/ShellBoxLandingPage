---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.svelte';
import Hero from '../components/sections/Hero.astro';
import Tiendas from '../components/sections/Tiendas.astro';
import Tarifas from '../components/sections/Tarifas.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Features from '../components/sections/Features.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTA from '../components/sections/CTA.astro';
import Footer from '../components/Footer.astro';
import BandaFoto from '../components/ui/BandaFoto.astro';
import { whatsappLink } from '../lib/config';

const ctaBanda = whatsappLink('¡Hola ShellBox! Quiero empezar mi encargo desde Estados Unidos.');
---

<BaseLayout>
  <Header client:load actual="/" />
  <main id="contenido">
    <Hero />
    <Tiendas />
    <Tarifas />
    <HowItWorks />

    {/* Rompe el ritmo de bloques con una imagen a sangre. Mientras no exista
        el archivo, se pinta el degradado de marca. */}
    <BandaFoto
      src="/fotos/entrega-vedado.jpg"
      alt=""
      titulo="Tu paquete, en tus manos"
      texto="Cada semana recibimos, clasificamos y entregamos decenas de encargos en El Vedado. Sin intermediarios y sin sorpresas en el precio."
    >
      <a
        href={ctaBanda}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-[0.875rem] bg-white px-7 py-3.5 font-semibold transition-transform duration-200 hover:scale-[1.02] active:scale-[0.98]"
        style="color: var(--color-brand-coral)"
      >
        Empezar mi encargo
      </a>
    </BandaFoto>

    <Features />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
