---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.svelte';
import Catalogo from '../components/ui/Catalogo.svelte';
import Footer from '../components/Footer.astro';
import CTA from '../components/sections/CTA.astro';
import { connectDB } from '../lib/db';
import Product from '../lib/models/Product';
import type { Producto } from '../lib/types';

/**
 * Los productos se leen de MongoDB en el servidor.
 *
 * Antes esta página leía de un array de ejemplo en memoria (`productStore.ts`),
 * así que nunca mostraba lo que el panel de administración guardaba.
 */
let productos: Producto[] = [];
let errorCarga = false;

try {
  await connectDB();
  const documentos = await Product.find({}).sort({ featured: -1, createdAt: -1 }).lean();
  // `lean()` devuelve objetos planos, pero con ObjectId y Date: se serializan
  // para poder pasarlos al componente de cliente.
  productos = JSON.parse(JSON.stringify(documentos)) as Producto[];
} catch (error) {
  console.error('Error al cargar el stock:', error);
  errorCarga = true;
}

const disponibles = productos.filter((p) => p.available).length;
---

<BaseLayout
  title="Stock en Cuba — ShellBox Encargos"
  description="Productos disponibles ahora mismo en Cuba, listos para recoger sin esperar encargo."
>
  <Header client:load actual="/stock" />

  <main id="contenido" class="pt-24">
    <!-- Encabezado -->
    <section class="relative overflow-hidden py-16 sm:py-20">
      <div
        class="pointer-events-none absolute -top-32 left-1/2 h-96 w-[42rem] -translate-x-1/2 rounded-full blur-[120px]"
        style="background: radial-gradient(circle, color-mix(in srgb, var(--color-brand-pink) 20%, transparent), transparent 70%)"
        aria-hidden="true"
      >
      </div>

      <div class="relative mx-auto max-w-4xl px-6 text-center sm:px-8 lg:px-12">
        <p
          class="text-xs font-semibold tracking-[0.2em] uppercase"
          style="color: var(--color-brand-pink)"
        >
          Disponible ahora
        </p>
        <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
          Stock en Cuba
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-lg" style="color: var(--text-muted)">
          Mercancía que ya está aquí, lista para recoger en El Vedado. Sin esperas ni encargo
          previo.
        </p>

        {
          !errorCarga && productos.length > 0 && (
            <p class="mt-6 text-sm" style="color: var(--text-faint)">
              <strong style="color: var(--text)">{disponibles}</strong> de {productos.length}{' '}
              {productos.length === 1 ? 'producto disponible' : 'productos disponibles'}
            </p>
          )
        }
      </div>
    </section>

    <section class="pb-20">
      <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
        {
          errorCarga ? (
            <div class="card px-6 py-20 text-center">
              <h2 class="text-xl font-bold">No pudimos cargar el stock</h2>
              <p class="mx-auto mt-2 max-w-md" style="color: var(--text-muted)">
                Ha habido un problema al conectar con la base de datos. Vuelve a intentarlo en
                unos minutos o escríbenos por WhatsApp.
              </p>
            </div>
          ) : (
            <Catalogo client:load productos={productos} />
          )
        }
      </div>
    </section>

    <CTA />
  </main>

  <Footer />
</BaseLayout>
